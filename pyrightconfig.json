{
  "include": [
    "backend",
    "start.py",
    "wsgi.py",
    "run_migrations_production.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv_py313",
  "**/backend/.venv",
  // Exclude optional dev/test utilities that rely on non-runtime deps
  "scripts/**",
  "conftest.py",
  "test_*.py"
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "venvPath": ".",
  "venv": "venv_py313",
  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.12",
      "pythonPlatform": "Linux",
      "extraPaths": [
        "./backend"
      ]
    }
  ],
  "typeCheckingMode": "standard",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none"
}
