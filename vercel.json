{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://structureddocs-srhab.ondigitalocean.app/api/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "https://structureddocs-srhab.ondigitalocean.app/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
