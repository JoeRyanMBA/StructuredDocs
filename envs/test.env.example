# StructuredDocs — TEST environment
# Copy to the test droplet as /opt/structureddocs/backend.env
# Never commit real secrets — fill in values after provisioning.

APP_ENV=test
PORT=8080
FLASK_ENV=development

# Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TEST_SECRET
JWT_SECRET_KEY=CHANGE_ME_TEST_JWT_SECRET

# Shared Managed Postgres — test database
# Get connection string from DO control panel → Databases → Connection Details
DATABASE_URL=postgresql://structureddocs_test:CHANGE_ME@DB_HOST:25060/structureddocs_test?sslmode=require

# CORS
FRONTEND_URL=https://test.yourdomain.com

# Spaces (shared bucket, test/ folder prefix)
SPACES_REGION=nyc3
SPACES_BUCKET=structureddocs-assets
SPACES_ACCESS_KEY=CHANGE_ME
SPACES_SECRET_KEY=CHANGE_ME
SPACES_KEY_PREFIX=test
# Optional CDN endpoint:
# SPACES_CDN_ENDPOINT=https://structureddocs-assets.nyc3.cdn.digitaloceanspaces.com

# Email — use debug mode in test to avoid sending real emails
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=StructuredDocs (Test)
MAIL_DEFAULT_SENDER=StructuredDocs Test <no-reply@yourdomain.com>
EMAIL_DEBUG=true

# Admin
ADMIN_API_KEY=CHANGE_ME_TEST_ADMIN_KEY

# Rate limits — relaxed for testing
RATE_LIMIT_DEFAULT=10000 per day;1000 per hour
RATE_LIMIT_LOGIN=100 per minute
RATE_LIMIT_AUTH=500 per hour
RATE_LIMIT_WRITE=1000 per hour

# Connection pooling
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background jobs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# Security headers
ENABLE_SECURITY_HEADERS=1

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Migrations — run on container start
RUN_DB_MIGRATIONS=1
