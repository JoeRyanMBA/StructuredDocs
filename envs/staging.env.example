# StructuredDocs - STAGING environment
# Copy to the staging server as /opt/structureddocs/backend.env
# Never commit real secrets - fill in values after provisioning.

APP_ENV=staging
PORT=8080
FLASK_ENV=production

# Secrets - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_STAGING_SECRET
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET

# Shared Managed Postgres - staging database
# Get connection string from your database provider console (Databases -> Connection Details)
DATABASE_URL=postgresql://structureddocs_staging:CHANGE_ME@DB_HOST:25060/structureddocs_staging?sslmode=require

# CORS
FRONTEND_URL=https://staging.yourdomain.com

# Email - production-like behavior (real sends enabled)
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=StructuredDocs (Staging)
MAIL_DEFAULT_SENDER=StructuredDocs Staging <no-reply@yourdomain.com>
EMAIL_DEBUG=false

# Admin
ADMIN_API_KEY=CHANGE_ME_STAGING_ADMIN_KEY

# Rate limits - standard
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_AUTH=30 per hour
RATE_LIMIT_WRITE=100 per hour

# Connection pooling
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background jobs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# Security headers
ENABLE_SECURITY_HEADERS=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Migrations - run on container start
RUN_DB_MIGRATIONS=1
