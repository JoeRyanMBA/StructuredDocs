# StructuredDocs - DEV environment
# Copy to the dev server as /opt/structureddocs/backend.env
# Never commit real secrets - fill in values after provisioning.

APP_ENV=dev
PORT=8080
FLASK_ENV=development

# Secrets - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_DEV_SECRET
JWT_SECRET_KEY=CHANGE_ME_DEV_JWT_SECRET

# Shared Managed Postgres - dev database
# Get connection string from DO control panel -> Databases -> Connection Details
DATABASE_URL=postgresql://structureddocs_dev:CHANGE_ME@DB_HOST:25060/structureddocs_dev?sslmode=require

# CORS
FRONTEND_URL=https://dev.yourdomain.com

# S3-compatible object storage (shared bucket, dev/ folder prefix)
SPACES_REGION=us-east-1
SPACES_BUCKET=structureddocs-assets
SPACES_ACCESS_KEY=CHANGE_ME
SPACES_SECRET_KEY=CHANGE_ME
SPACES_KEY_PREFIX=dev
# Optional CDN endpoint:
# SPACES_CDN_ENDPOINT=https://cdn.example.com/structureddocs-assets

# Email - keep debug mode enabled in dev to avoid sending real emails
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=StructuredDocs (Dev)
MAIL_DEFAULT_SENDER=StructuredDocs Dev <no-reply@yourdomain.com>
EMAIL_DEBUG=true

# Admin
ADMIN_API_KEY=CHANGE_ME_DEV_ADMIN_KEY

# Rate limits - relaxed for rapid testing
RATE_LIMIT_DEFAULT=10000 per day;1000 per hour
RATE_LIMIT_LOGIN=100 per minute
RATE_LIMIT_AUTH=500 per hour
RATE_LIMIT_WRITE=1000 per hour

# Connection pooling
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background jobs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# Security headers
ENABLE_SECURITY_HEADERS=1

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Migrations - run on container start
RUN_DB_MIGRATIONS=1
