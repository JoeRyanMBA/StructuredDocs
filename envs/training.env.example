# StructuredDocs — TRAINING environment
# Copy to the training droplet as /opt/structureddocs/backend.env
# Never commit real secrets — fill in values after provisioning.

APP_ENV=training
PORT=8080
FLASK_ENV=production

# Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TRAINING_SECRET
JWT_SECRET_KEY=CHANGE_ME_TRAINING_JWT_SECRET

# Shared Managed Postgres — training database
# Get connection string from DO control panel → Databases → Connection Details
DATABASE_URL=postgresql://structureddocs_training:CHANGE_ME@DB_HOST:25060/structureddocs_training?sslmode=require

# CORS
FRONTEND_URL=https://training.yourdomain.com

# Spaces (shared bucket, training/ folder prefix)
SPACES_REGION=nyc3
SPACES_BUCKET=structureddocs-assets
SPACES_ACCESS_KEY=CHANGE_ME
SPACES_SECRET_KEY=CHANGE_ME
SPACES_KEY_PREFIX=training
# Optional CDN endpoint:
# SPACES_CDN_ENDPOINT=https://structureddocs-assets.nyc3.cdn.digitaloceanspaces.com

# Email — real sends enabled for training
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=StructuredDocs (Training)
MAIL_DEFAULT_SENDER=StructuredDocs Training <no-reply@yourdomain.com>
EMAIL_DEBUG=false

# Admin
ADMIN_API_KEY=CHANGE_ME_TRAINING_ADMIN_KEY

# Rate limits — standard
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_AUTH=30 per hour
RATE_LIMIT_WRITE=100 per hour

# Connection pooling
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=7
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background jobs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# Security headers
ENABLE_SECURITY_HEADERS=1

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Migrations — run on container start
RUN_DB_MIGRATIONS=1
