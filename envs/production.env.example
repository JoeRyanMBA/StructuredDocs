# StructuredDocs — PRODUCTION environment
# Copy to the production server as /opt/structureddocs/backend.env
# Never commit real secrets — fill in values after provisioning.

APP_ENV=production
PORT=8080
FLASK_ENV=production

# Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_PROD_SECRET
JWT_SECRET_KEY=CHANGE_ME_PROD_JWT_SECRET

# Shared Managed Postgres — production database
# Get connection string from your database provider console (Databases -> Connection Details)
DATABASE_URL=postgresql://structureddocs_prod:CHANGE_ME@DB_HOST:25060/structureddocs_prod?sslmode=require

# CORS
FRONTEND_URL=https://yourdomain.com

# S3-compatible object storage (shared bucket, prod/ folder prefix)
SPACES_REGION=us-east-1
SPACES_BUCKET=structureddocs-assets
SPACES_ACCESS_KEY=CHANGE_ME
SPACES_SECRET_KEY=CHANGE_ME
SPACES_KEY_PREFIX=prod
# Optional CDN endpoint (recommended for production):
# SPACES_CDN_ENDPOINT=https://cdn.example.com/structureddocs-assets

# Email
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=StructuredDocs
MAIL_DEFAULT_SENDER=StructuredDocs <no-reply@yourdomain.com>
EMAIL_DEBUG=false

# Admin
ADMIN_API_KEY=CHANGE_ME_PROD_ADMIN_KEY

# Rate limits — production defaults
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_AUTH=30 per hour
RATE_LIMIT_WRITE=100 per hour
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Background jobs
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# Security headers
ENABLE_SECURITY_HEADERS=1
CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src *; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...

# Migrations — run on container start
RUN_DB_MIGRATIONS=1
