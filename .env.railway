# Railway Configuration
# This file configures Railway deployment for StructuredDocs

# Railway will automatically detect this as a Python app
# and use the requirements.txt and start.sh

# Environment variables for Railway
RAILWAY_STATIC_URL=
RAILWAY_ENVIRONMENT=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=

# Database configuration (Railway provides PostgreSQL)
DATABASE_URL=

# Flask configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Frontend build configuration
NODE_ENV=production
