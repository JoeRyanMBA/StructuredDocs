# Production Email Configuration Template
# Copy this to your production environment and update the values

# Email Service Configuration
EMAIL_DEBUG=false

# Production SMTP Settings (Example: Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-production-email@yourdomain.com
SMTP_PASSWORD=your-app-password-here
# Set to true to force SMTPS on port 465, otherwise STARTTLS on 587
SMTP_USE_SSL=false

# Email Branding
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME="YourApp Review System"

# Production Frontend URL
FRONTEND_URL=https://app.yourdomain.com

# Alternative SMTP Providers:
# 
# SendGrid:
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# Admin API key used for protected admin utilities (e.g., /api/admin/send-test-email)
# Set to a long random string and keep it secret in your platform env settings
ADMIN_API_KEY=change-me-long-random-string
#
# Provider-based Email (optional, simpler than SMTP on DO):
# To use Postmark:
# EMAIL_PROVIDER=postmark
# POSTMARK_API_TOKEN=pm_xxx
# POSTMARK_MESSAGE_STREAM=outbound
#
# To use Resend:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
#
# AWS SES:
# SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your-ses-username
# SMTP_PASSWORD=your-ses-password
#
# Mailgun:
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@yourdomain.com
# SMTP_PASSWORD=your-mailgun-password
