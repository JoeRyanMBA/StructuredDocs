# Example environment configuration for backend (DigitalOcean + Managed Postgres)
# Copy this file to `.env` (repo root) or configure these in the Droplet environment.
# Never commit real secrets.

# Flask / App
FLASK_ENV=production
SECRET_KEY=change-me-super-secret
JWT_SECRET_KEY=change-me-jwt-secret
PORT=5050

# CORS
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database (Managed Postgres)
# Managed DB URL usually looks like: postgres://user:password@host:port/dbname
DATABASE_URL=postgresql://username:password@host:5432/structured_docs
DISABLE_SQLITE_FALLBACK=1

# Email (example SMTP / could be Mailgun, SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me
MAIL_DEFAULT_SENDER=StructuredDocs <no-reply@example.com>

# Optional Integrations
SENTRY_DSN=
REDIS_URL=

# Background Jobs (Redis/RQ)
RQ_WORKER_CONCURRENCY=2
RQ_JOB_TIMEOUT=300

# Security / Rate Limiting
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_STORAGE_URI=
ENABLE_SECURITY_HEADERS=1

# SQLAlchemy Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Feature Flags
ENABLE_BLUEPRINTS=
# e.g. ENABLE_BLUEPRINTS=admin,projects,reviews

# Logging
LOG_LEVEL=info

# Build / Version Metadata (usually injected by CI/CD)
APP_VERSION=
GIT_COMMIT=
BUILD_TIME=
