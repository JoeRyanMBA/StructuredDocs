# Example environment configuration for backend (DigitalOcean + Managed Postgres)
# Copy this file to `.env` (repo root) or configure these in the Droplet environment.
# Never commit real secrets.

# Flask / App
FLASK_ENV=production
SECRET_KEY=change-me-super-secret
JWT_SECRET_KEY=change-me-jwt-secret
PORT=5050

# CORS
FRONTEND_URL=https://your-vercel-app.vercel.app

# Database (Managed Postgres)
# Managed DB URL usually looks like: postgres://user:password@host:port/dbname
DATABASE_URL=postgresql://username:password@host:5432/structured_docs
DISABLE_SQLITE_FALLBACK=1

# Email (example SMTP / could be Mailgun, SES, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me
MAIL_DEFAULT_SENDER=StructuredDocs <no-reply@example.com>

# Optional Integrations
SENTRY_DSN=
REDIS_URL=

# Feature Flags
ENABLE_BLUEPRINTS=
# e.g. ENABLE_BLUEPRINTS=admin,projects,reviews

# Logging
LOG_LEVEL=info
