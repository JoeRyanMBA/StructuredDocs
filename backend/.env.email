# Email Configuration for Real Email Sending
# Copy these to your main .env file or export them in your terminal

# Disable debug mode to send real emails
EMAIL_DEBUG=false

# Gmail SMTP Configuration (replace with your details)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_gmail@gmail.com
FROM_NAME=StructuredDocs Review System

# Frontend URL for review links
FRONTEND_URL=http://localhost:3000
