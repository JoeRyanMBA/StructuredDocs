# Email Configuration for Real Email Sending
# Copy these to your main .env file or export them in your terminal

# Disable debug mode to send real emails
EMAIL_DEBUG=false

# SendGrid Configuration (replace with your details)
SENDGRID_API_KEY=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=no-reply@structureddocs.online

# Frontend URL for review links
FRONTEND_URL=http://StructuredDocs.online   
