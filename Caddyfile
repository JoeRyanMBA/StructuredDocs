# StructuredDocs Caddy reverse proxy with auto HTTPS
# Set DOMAIN env var (e.g. structureddocs.online) or falls back to localhost for dev.
# Serves the apex plus common environment subdomains.

{$DOMAIN:localhost}, dev.{$DOMAIN:localhost}, staging.{$DOMAIN:localhost} {
    # Proxy all traffic directly to the app container, which serves both the SPA and API.
    reverse_proxy app:8080

    # Compress responses
    encode gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
