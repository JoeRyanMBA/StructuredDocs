# Core app
PORT=8080
ENABLE_BLUEPRINTS_FILE=.enable_blueprints
DATABASE_URL=sqlite:///structured_docs.db
FRONTEND_URL=https://structureddocs.online

# Admin API for test endpoints
ADMIN_API_KEY=change-me-strong-token

# Email provider selection
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=
# Option A: Use a verified single sender (fastest to pass DMARC)
SENDGRID_VERIFIED_SENDER=verified@yourdomain.com
# Option B: Use domain-authenticated From (set after SendGrid domain authentication)
DEFAULT_FROM_EMAIL=no-reply@structureddocs.online
FROM_EMAIL=
FROM_NAME=StructuredDocs

# SMTP fallback (not needed if using SendGrid)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Debug mode writes emails to backend/debug_emails instead of sending
EMAIL_DEBUG=false
