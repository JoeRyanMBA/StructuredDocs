# Core app
PORT=8080
ENABLE_BLUEPRINTS_FILE=.enable_blueprints
DATABASE_URL=sqlite:///structured_docs.db
FRONTEND_URL=https://structureddocs.online

# Admin API for test endpoints
ADMIN_API_KEY=change-me-strong-token

# Email provider selection
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=
# Option A: Use a verified single sender (fastest to pass DMARC)
SENDGRID_VERIFIED_SENDER=verified@yourdomain.com
# Option B: Use domain-authenticated From (set after SendGrid domain authentication)
DEFAULT_FROM_EMAIL=no-reply@structureddocs.online
FROM_EMAIL=
FROM_NAME=StructuredDocs

# SMTP fallback (not needed if using SendGrid)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Debug mode writes emails to backend/debug_emails instead of sending
EMAIL_DEBUG=false

# ---------------------------------------------------------------------------
# Rate limiting configuration (Flask-Limiter)
# Format examples: "200 per day;50 per hour" or "20 per minute" etc.
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_AUTH=30 per hour
RATE_LIMIT_WRITE=100 per hour

# ---------------------------------------------------------------------------
# SQLAlchemy connection pooling (non-SQLite only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Background jobs (Redis / RQ)
REDIS_URL=redis://localhost:6379/0
RQ_QUEUES=default

# ---------------------------------------------------------------------------
# Security headers toggle & custom policies
ENABLE_SECURITY_HEADERS=1
CSP_HEADER=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src *; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()

# ---------------------------------------------------------------------------
# Build / version metadata (injected during CI build if provided)
APP_VERSION=0.2.0
GIT_COMMIT=
BUILD_TIME=
